# Copy to .env and fill in. Never commit the filled-in file.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time and are
# readable by anyone with the APK. Do not put anything secret here — restrict
# the Azure key by referrer/origin instead.

# API base URL, including the /api/v1 suffix.
#   Android emulator reaching the host machine: http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Azure Maps subscription key used for tiles and rendering
EXPO_PUBLIC_AZURE_MAPS_KEY=""
