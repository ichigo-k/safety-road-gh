# Root GitIgnore for Safety Road GH
.env
.env.*
*.env
web/.env
web/.env.*
mobile/.env
mobile/.env.*

# ...but the templates are part of the project
!.env.example
!web/.env.example
!mobile/.env.example
node_modules/
web/node_modules/
mobile/node_modules/
.next/
web/.next/
dist/
build/
.DS_Store
*.log

# Local SQLite, superseded by Neon Postgres
web/prisma/dev.db
web/prisma/*.db-journal

# Editor and local tooling — kept on disk, not part of the project
.vscode/
.idea/

# AI assistant configuration and skill packs
.claude/
.agents/
skills-lock.json
AGENTS.md
CLAUDE.md
