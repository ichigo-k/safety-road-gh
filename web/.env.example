# Copy to .env and fill in. Never commit the filled-in file.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/safety_road_gh"

# Signs session tokens. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Azure Maps — server-side geocoding and routing
AZURE_MAPS_KEY=""
# Azure Maps — browser map rendering (public, inlined into the client bundle)
NEXT_PUBLIC_AZURE_MAPS_KEY=""

# Cloudinary — incident photo uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Optional — password-reset email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Safety Road GH <no-reply@example.com>"

# Optional — surfaces the latest APK download on the public site
GITHUB_TOKEN=""
GITHUB_RELEASES_REPO="owner/repo"
