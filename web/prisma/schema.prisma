datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String           @id @default(uuid())
  full_name        String
  email            String           @unique
  phone            String?
  password_hash    String
  role             String           @default("CITIZEN")
  is_verified      Boolean          @default(false)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  accident_reports AccidentReport[]
  road_hazards     RoadHazard[]
  notifications    Notification[]

  @@map("users")
}

model AccidentReport {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accident_type String
  description   String
  vehicle_count Int      @default(0)
  injured_count Int      @default(0)
  latitude      Float
  longitude     Float
  location      String
  image_url     String?
  status        String   @default("PENDING")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("accident_reports")
}

model RoadHazard {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  hazard_type String
  description String
  latitude    Float
  longitude   Float
  location    String
  image_url   String?
  status      String   @default("PENDING")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("road_hazards")
}

model RoadAlert {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String?
  latitude    Float?
  longitude   Float?
  severity    String   @default("MEDIUM")
  active      Boolean  @default(true)
  // Geofenced broadcast: when set alongside a coordinate, only devices within
  // this radius receive the alert. Null means network-wide.
  radius_km   Float?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("road_alerts")
}

/// An accident-prone area. Rows with source = DERIVED are rebuilt from
/// incident reports by lib/hotspots.ts; OFFICIAL rows are entered by MTTD and
/// are never overwritten by a recompute.
model Hotspot {
  id               String    @id @default(uuid())
  name             String
  latitude         Float
  longitude        Float
  /// Alert geofence radius. Derived from how far the member incidents spread.
  radius_m         Int       @default(400)
  /// 0-100, saturating. Combines incident count, recency, type and casualties.
  risk_score       Float     @default(0)
  severity         String    @default("MEDIUM")
  dominant_type    String    @default("ACCIDENT")
  incident_count   Int       @default(0)
  casualty_count   Int       @default(0)
  /// JSON array of 24 floats, 0-1, risk by hour of day. SQLite has no native
  /// JSON column through Prisma, so this is stored as text.
  hour_profile     String    @default("[]")
  /// ACTIVE | MONITORING | UNDER_REPAIR | MITIGATED
  status           String    @default("ACTIVE")
  /// DERIVED | OFFICIAL
  source           String    @default("DERIVED")
  notes            String?
  last_incident_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([latitude, longitude])
  @@index([status])
  @@map("hotspots")
}

model EmergencyService {
  id         String   @id @default(uuid())
  name       String
  type       String
  phone      String
  // The admin form has always collected these two, but there were no columns
  // to put them in: the API dropped them and the list rendered the literal
  // string "undefined" where the region should be. Nullable because every row
  // that predates them has neither.
  alt_phone  String?
  region     String?
  address    String
  latitude   Float
  longitude  Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("emergency_services")
}

model SafetyTip {
  id          String   @id @default(uuid())
  title       String
  category    String
  description String
  image_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("safety_tips")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("notifications")
}
